     1|# ─────────────────────────────────────────────────────────────
     2|# Jazy's House Platform — Environment Variables (template)
     3|# Copy to .env and fill in real values. NEVER commit .env.
     4|# ─────────────────────────────────────────────────────────────
     5|
     6|# ── Database (PostgreSQL via Supabase free tier) ──
     7|# Supabase → Project Settings → Database → Connection string.
     8|# Use the "Transaction" pooler (port 6543) for the runtime app (serverless-friendly),
     9|# and the "Session"/direct connection (port 5432) for migrations.
    10|DATABASE_URL="postgresql://postgres.<project-ref>:***@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
    11|DIRECT_URL="postgresql://postgres.<project-ref>:***@aws-0-<region>.pooler.supabase.com:5432/postgres"
    12|
    13|# ── Stripe (server-side only — NEVER expose the secret key to the client) ──
    14|STRIPE_SECRET_KEY="sk_tes...E_ME"
    15|STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
    16|# Publishable key is safe to expose to the browser (Phase 4).
    17|NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
    18|
    19|# ── Auth (Phase 2 — NextAuth/Auth.js) ──
    20|# Generate with: openssl rand -base64 32
    21|AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
    22|# Password used for the seeded admin accounts (admin@ / owner@jazyshouse.com).
    23|# Dev-only convenience; override in any shared environment.
    24|SEED_ADMIN_PASSWORD="admin1234"
    25|
    26|# ── App ──
    27|# Base URL of the platform (used for Stripe redirect URLs, absolute links).
    28|NEXT_PUBLIC_APP_URL="http://localhost:3000"
    29|# Root domain for subdomain-based tenant resolution (e.g. "jazyshouse.com").
    30|# In dev, tenants resolve via path (/store/jazyshouse) or subdomain (jazyshouse.localhost:3000).
    31|NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
    32|# Tenant served on the bare root domain (e.g. localhost:3000) when no subdomain
    33|# or custom domain matches. Falls back to the oldest tenant if unset/not found.
    34|DEFAULT_TENANT_SLUG="jazyshouse"
    35|
    36|# ── Production / deployment notes (Vercel) ──
    37|# Set the vars above in the Vercel project (Settings → Environment Variables).
    38|# In production:
    39|#   • NEXT_PUBLIC_APP_URL  → your canonical https URL (e.g. https://jazyshouse.com)
    40|#   • NEXT_PUBLIC_ROOT_DOMAIN → bare root domain for subdomain routing (jazyshouse.com)
    41|#   • DATABASE_URL → pooled (port 6543); DIRECT_URL → direct (5432) for migrations
    42|#   • STRIPE_* → swap test keys for live keys; point the webhook at /api/webhooks/stripe
    43|# NextAuth (Auth.js v5) auto-detects the host on Vercel. If you serve tenants on
    44|# custom domains behind a proxy and hit host/callback mismatches, set:
    45|# AUTH_TRUST_HOST="true"
    46|
    47|# ── Optional integrations (not required to run; wire up when adopted) ──
    48|# Transactional email (e.g. order receipts) via Resend:
    49|# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
    50|# Image CDN — Cloudinary is already whitelisted in next.config.ts remotePatterns:
    51|# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
    52|# Vercel Blob (product image uploads) — also whitelisted in next.config.ts:
    53|# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
    54|