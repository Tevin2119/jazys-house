// Jazy's House Platform — Prisma schema
// Tenant-first design: every customer-facing model is scoped by tenantId.
// Money is stored as integer minor units (e.g. cents/pence), NEVER as Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  currency  String   @default("gbp") // ISO 4217, lowercase (Stripe convention)
  theme     Json? // { primary, secondary, font, radius, logoUrl }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          Product[]
  categories        Category[]
  orders            Order[]
  orderItems        OrderItem[]
  users             User[]
  memberships       TenantMembership[]
  cateringInquiries CateringInquiry[]
  newsletterSignups NewsletterSignup[]
  savedQueries      SavedQuery[]
  wishlistItems     WishlistItem[]
  orderStatusLogs   OrderStatusLog[]
  orderMessages     OrderMessage[]
  shipments         Shipment[]
  refunds           Refund[]
  carrierConfigs    TenantCarrier[]
  webhookEvents     StripeWebhookEvent[]
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  price       Int // minor units (pence). e.g. £85.00 -> 8500
  description String?
  images      String[] // image URLs (Vercel Blob / Cloudinary)
  emoji       String? // fallback glyph from the static site catalog
  badge       String? // "BESTSELLER", "NEW", "SALE", "LIMITED", ...
  badgeClass  String? // CSS modifier from the static site ("new", "sale", "")
  stock       Int       @default(999)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  // COUNCIL FIX: products are addressed by slug within a tenant; slug must be
  // unique per tenant (not globally) so two stores can both have "ankara-tote-bag".
  @@unique([tenantId, slug])
  @@index([tenantId, categoryId])
  @@index([tenantId, deletedAt])
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id       String      @id @default(cuid())
  tenantId String
  // Deliberately NOT onDelete: Cascade — orders are financial records and must
  // survive tenant deletion (default Restrict blocks deleting a tenant with orders).
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  status   OrderStatus @default(PENDING)
  total    Int // minor units (pence) — server-computed, never trusted from client
  currency String      @default("gbp")
  email    String?
  name     String?
  address  Json? // shipping address snapshot

  // G-82: contact phone (required by Japanese carriers for label creation)
  phone         String?

  // G-79: financial breakdown — subtotal + shippingTotal must always sum to total
  subtotal      Int     @default(0) // minor units — item lines before shipping
  shippingTotal Int     @default(0) // minor units — shipping charge at time of order

  // Stripe integration (Phase 4)
  stripeSessionId String? @unique
  // COUNCIL FIX: webhook idempotency — the Stripe event id that last mutated this
  // order. @unique makes idempotency a DB-level guarantee: the same event can be
  // recorded against at most one order, so concurrent duplicate deliveries can
  // never both apply a payment. (Postgres allows many NULLs under a unique index,
  // so unpaid orders are unaffected.)
  stripeEventId   String? @unique

  // G-80: payment details — provider, method, and provider-assigned IDs
  paymentProvider String?   // STRIPE, KOMOJU
  paymentMethod   String?   // card, paypay, konbini, bank_transfer
  paymentId       String?   // provider's charge / payment ID
  paymentStatus   String?   // PENDING, COMPLETED, FAILED, REFUNDED
  paidAt          DateTime?
  checkoutAttemptId    String? @unique
  stripePaymentIntentId String? @unique

  items      OrderItem[]
  statusLogs OrderStatusLog[]
  messages   OrderMessage[]
  shipments  Shipment[]
  refunds    Refund[]
  webhookEvents StripeWebhookEvent[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model StripeWebhookEvent {
  id        String   @id // Stripe event id
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  type      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([tenantId])
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int // minor units — price snapshot at time of order

  // COUNCIL FIX: tenantId scopes every OrderItem to its tenant.
  // Combined with order's tenantId, this creates a dual fence against
  // cross-tenant product attachment (Phase 4 must enforce both match).
  @@index([orderId])
  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum MessageSide {
  CUSTOMER
  STORE
}

enum CarrierType {
  YAMATO
  SAGAWA
  JAPAN_POST
  OTHER
}

enum RefundStage {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
}

// ─────────────────────────────────────────────────────────────
// Users / Auth (NextAuth wired up in Phase 2)
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // bcrypt hash for credentials login (Phase 2). Null for accounts that have not
  // set a password (e.g. seeded customers, future OAuth-only users).
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  tenantId     String? // null = super admin (spans all tenants)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)
  authVersion  Int      @default(1)

  // COUNCIL FIX (JH-004): TenantMembership replaces single tenantId for
  // multi-tenant users. A user can belong to multiple tenants with different
  // roles per tenant (e.g. TENANT_ADMIN on store A, CUSTOMER on store B).
  // The existing tenantId field stays for backward compat — SUPER_ADMIN users
  // (tenantId=null) still work. For TENANT_ADMIN users, migrate to memberships.
  memberships TenantMembership[]

  @@index([tenantId])
}

// COUNCIL FIX (JH-004): explicit many-to-many membership model.
// Replaces the single User.tenantId for users who manage or shop at
// multiple stores. One user can be a TENANT_ADMIN on store A and a
// CUSTOMER on store B.
model TenantMembership {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        UserRole @default(CUSTOMER) // role WITHIN this tenant
  permissions Json?    // { orders: {view,edit,manage}, products: {…}, … }
  createdAt   DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  EMPLOYEE
  TENANT_ADMIN
  CUSTOMER
}

// ─────────────────────────────────────────────────────────────
// Order Audit Trail
// ─────────────────────────────────────────────────────────────

model OrderStatusLog {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  oldStatus OrderStatus?
  newStatus OrderStatus
  changedBy String? // userId of the actor
  reason    String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Order Messages
// ─────────────────────────────────────────────────────────────

model OrderMessage {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  content    String
  side       MessageSide
  senderName String
  isInternal Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Shipping
// ─────────────────────────────────────────────────────────────

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  carrier        CarrierType
  trackingNumber String?
  labelUrl       String?
  status         String          @default("PENDING")
  createdAt      DateTime        @default(now())
  events         ShipmentEvent[]

  @@index([orderId])
  @@index([tenantId])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  timestamp   DateTime

  @@index([shipmentId])
}

// ─────────────────────────────────────────────────────────────
// Carrier Config (G-84) — minimum credentials for Ship&co label creation
// ─────────────────────────────────────────────────────────────

model TenantCarrier {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier          CarrierType
  apiKeyEncrypted  String? // AES-256-GCM ciphertext; never return to the client
  originPostalCode String?
  originAddress    Json? // { line1, city, prefecture, country }
  enabled          Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([tenantId, carrier])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Refunds
// ─────────────────────────────────────────────────────────────

model Refund {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  amount    Int // minor units (same currency as order)
  reason    String?
  stage     RefundStage @default(REQUESTED)
  method    String?

  // G-81: provider execution and idempotency
  providerRefundId  String? // provider-assigned refund ID
  providerPaymentId String? // original payment ID — idempotency key for re-submission
  failureReason     String? // populated if provider refund fails

  createdAt DateTime    @default(now())

  @@unique([providerRefundId])
  @@index([orderId])
  @@index([tenantId, stage])
}

// ─────────────────────────────────────────────────────────────
// Catering
// ─────────────────────────────────────────────────────────────

model CateringInquiry {
  id String @id @default(cuid())

  // COUNCIL FIX: catering inquiries are tenant-scoped like everything else.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  email     String
  date      String
  guests    Int
  package   String?
  message   String
  status    String   @default("new") // new, contacted, booked, declined
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────────────────────
// Newsletter
// ─────────────────────────────────────────────────────────────

model NewsletterSignup {
  id String @id @default(cuid())

  // Tenant-scoped like every other customer-facing model.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email     String
  createdAt DateTime @default(now())

  // One signup per email per tenant — re-subscribing is idempotent.
  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Admin Query Builder
// ─────────────────────────────────────────────────────────────

model SavedQuery {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  config    Json // { model, fields, filters, sort }
  createdBy String // User email
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Wishlist
// ─────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, productId])
  @@index([tenantId, userId])
}
